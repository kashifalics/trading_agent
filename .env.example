# Copy to .env (scripts/setup.ps1 or scripts/setup.sh does this and generates secrets). NEVER commit .env.
# Nothing here costs money. Only variables the code actually reads are active.

# ---- core -------------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change-me-generated-by-setup-script
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
AUTH_REQUIRED=false            # true => every API call needs an X-API-Key (mandatory when APP_ENV=production)

# ---- database / queue (docker compose composes DATABASE_URL from these) ------
POSTGRES_USER=ati
POSTGRES_PASSWORD=change-me-generated-by-setup-script
POSTGRES_DB=ati
# For running the backend OUTSIDE docker, e.g. against a local Postgres (default if unset: sqlite:///./dev.db):
# DATABASE_URL=postgresql+psycopg://ati:password@localhost:5432/ati
# MIGRATION_DATABASE_URL=postgresql+psycopg://ati:password@localhost:5432/ati   # optional, alembic only
# REDIS_URL=redis://localhost:6379/0                                               # + JOB_BACKEND=celery

# ---- market data -------------------------------------------------------------
BINANCE_API_BASE_URL=https://api.binance.com     # public market data, no key. Alt: https://data-api.binance.vision
# Twelve Data FREE plan key (https://twelvedata.com/pricing -> sign up yourself). Needed only for XAUUSD.
TWELVE_DATA_API_KEY=

# ---- optional / reserved -----------------------------------------------------
# Read by the settings loader but NOT used by any v0.1 code path (no object storage, no LLM calls, no Sentry required):
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=
# LLM_PROVIDER=none
# LLM_MODEL=
# OPENAI_API_KEY=
# SENTRY_DSN=                    # install sentry-sdk to activate
