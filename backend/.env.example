# Backend-only settings (running `uvicorn` directly). With docker compose use the root .env instead.
APP_ENV=development
APP_SECRET_KEY=change-me
DATABASE_URL=sqlite:///./dev.db
# MIGRATION_DATABASE_URL=
# REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
AUTH_REQUIRED=false
JOB_BACKEND=inline
BINANCE_API_BASE_URL=https://api.binance.com
TWELVE_DATA_API_KEY=
# OANDA free practice (demo) account token - needed for US30 and USOIL. Read-only use.
# https://www.oanda.com/register/#/sign-up/demo  ->  Manage API Access
OANDA_API_TOKEN=
# OANDA_BASE_URL=https://api-fxpractice.oanda.com
# BiQuote: free public API, no key. Override only to point at a mirror.
# BIQUOTE_BASE_URL=https://biquote.io
# Default data source when a request names none. Set empty to route by mapping status (Binance / Twelve Data / OANDA).
PREFERRED_PROVIDER=biquote
MODEL_DIR=./model_store
UPLOAD_DIR=./uploads
# Reserved / unused in v0.1: S3_ENDPOINT S3_BUCKET S3_ACCESS_KEY S3_SECRET_KEY S3_REGION LLM_PROVIDER LLM_MODEL OPENAI_API_KEY SENTRY_DSN

# Trade Opportunities (docs/TRADE_OPPORTUNITIES_ARCHITECTURE.md)
OPPORTUNITY_SYMBOLS=XAUUSD,US30,BTCUSDT,USOIL
# 0 = automatic scanning off. >0 = scan every N minutes inside the API process (30 s after start, then every N min).
OPPORTUNITY_SCAN_INTERVAL_MINUTES=0
# Providers a SCHEDULED scan may sync (quota-limited providers such as Twelve Data stay manual).
OPPORTUNITY_REFRESH_PROVIDERS=binance
OPPORTUNITY_MAX_SYNC_TFS=4

# Signal engine (docs/SIGNAL_ENGINE.md) - the Signals page
SIGNAL_SYMBOLS=XAUUSD,BTCUSDT,US30,USOIL
# Round-trip spread your broker charges, in PRICE units (BTC $2, gold $0.30). Instruments not listed pay 0.02% of price.
SIGNAL_SPREADS=BTCUSDT:2,XAUUSD:0.30
# One provider per instrument for the signal engine (never mixed). Binance gives BTCUSDT years of history without a key.
SIGNAL_PROVIDER_OVERRIDES=BTCUSDT:binance
# Providers the Signals page may sync automatically (keyless ones; Twelve Data's free quota stays manual).
SIGNAL_REFRESH_PROVIDERS=biquote,binance

# Paper trading (docs/PAPER_TRADING.md) - simulated orders only, no broker
# Seconds between in-process cycles (sync -> analyse -> simulate -> record). 0 = off (use "Run cycle now" / POST /paper/run).
PAPER_TRADING_INTERVAL_SECONDS=60
# Defaults for a new paper account (editable on the Paper Trading page)
PAPER_START_BALANCE=10000
PAPER_RISK_PCT=0.5
PAPER_MAX_OPEN_POSITIONS=5
PAPER_MAX_DAILY_LOSS_PCT=2
