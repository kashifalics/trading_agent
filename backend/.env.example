# Backend-only settings (running `uvicorn` directly). With docker compose use the root .env instead.
APP_ENV=development
APP_SECRET_KEY=change-me
DATABASE_URL=sqlite:///./dev.db
# MIGRATION_DATABASE_URL=
# REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
AUTH_REQUIRED=false
JOB_BACKEND=inline
BINANCE_API_BASE_URL=https://api.binance.com
TWELVE_DATA_API_KEY=
MODEL_DIR=./model_store
UPLOAD_DIR=./uploads
# Reserved / unused in v0.1: S3_ENDPOINT S3_BUCKET S3_ACCESS_KEY S3_SECRET_KEY S3_REGION LLM_PROVIDER LLM_MODEL OPENAI_API_KEY SENTRY_DSN
